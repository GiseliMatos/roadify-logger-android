    <string name="sensor_detail_chart_filter_note">Charts are smoothed only for display. Numerical readings and saved files preserve the original values.</string>
    <string name="sensor_detail_gps_active">GPS signal available.</string>
    <string name="sensor_detail_gps_description">Records geographic position, accuracy and speed provided by the device location system.</string>
    <string name="sensor_detail_barometer_description">Measures atmospheric pressure and estimates altitude relative to standard sea-level pressure.</string>
    <string name="sensor_detail_camera_description">Captures route video using a power-efficient HD 720p profile, limited to approximately 2 Mbps to reduce heat, battery use and storage.</string>
    <string name="sensor_detail_microphone_description">Records ambient mono AAC audio at 24 kHz and 48 kbps and displays the instantaneous signal amplitude.</string>
    <string name="sensor_detail_units_gps_body">Latitude and longitude are reported in decimal degrees, accuracy in meters and speed in meters per second.</string>
    <string name="sensor_detail_units_barometer_body">Pressure in hectopascals (hPa) and estimated altitude in meters (m).</string>
    <string name="sensor_detail_units_camera_body">Video is saved as a media file associated with the recording.</string>
    <string name="sensor_detail_units_microphone_body">Amplitude is an instantaneous digital scale from 0 to 32767; audio is saved as a media file.</string>
    <string name="sensor_detail_gps_note">More frequent GPS updates increase battery consumption.</string>
    <string name="sensor_detail_camera_note">Recording requires 250 MB of free space and automatically stops if the battery reaches 45 °C. Other sensors continue recording.</string>
    <string name="sensor_detail_microphone_note">Microphone permission is required and conversations in the environment may be recorded.</string>
    <string name="sensor_detail_battery_level_description">Shows the current battery charge percentage reported by Android.</string>
    <string name="sensor_detail_battery_temperature_description">Shows the current battery temperature reported by Android.</string>
    <string name="sensor_detail_units_battery_level_body">Battery charge as a percentage (%).</string>
    <string name="sensor_detail_units_battery_temperature_body">Battery temperature in degrees Celsius (°C).</string>
    <string name="sensor_detail_battery_note">Values are provided by the system and accuracy depends on the device hardware.</string>
