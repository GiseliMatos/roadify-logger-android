    <string name="sensor_detail_description_title">Description</string>
    <string name="sensor_detail_accel_description">Measures acceleration in the device coordinate system. Gravity is removed by the operating system, not by this app. When available, an additional file named Total Acceleration is recorded, containing the sum of linear acceleration and the gravitational acceleration vector.</string>
    <string name="sensor_detail_gyro_description">Measures the device rotation rate around each of its three physical axes (x, y and z), in radians per second.</string>
