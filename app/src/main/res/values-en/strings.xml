    <string name="sensor_detail_units_title">Units</string>
    <string name="sensor_detail_units_accel_body">Reported in m/s², always in the device coordinate system (x, y, z). Assumes g = 9.80665 m/s².</string>
    <string name="sensor_detail_units_gyro_body">Reported in rad/s, following the right-hand rule around each axis.</string>
