    <string name="sensor_detail_description_title">Descripción</string>
    <string name="sensor_detail_accel_description">Mide la aceleración en el sistema de coordenadas del dispositivo. La gravedad la elimina el sistema operativo, no esta aplicación. Cuando está disponible, se graba un archivo adicional llamado Aceleración total, que contiene la suma de la aceleración lineal y el vector de aceleración gravitacional.</string>
    <string name="sensor_detail_gyro_description">Mide la velocidad de rotación del dispositivo alrededor de sus tres ejes físicos (x, y y z), en radianes por segundo.</string>
    <string name="sensor_detail_notes_title">Notas importantes</string>
    <string name="sensor_detail_high_freq_warning">Las frecuencias de muestreo altas pueden agotar rápidamente la batería.</string>
    <string name="sensor_detail_shortcuts_title">Accesos directos de configuración</string>
    <string name="sensor_detail_change_rate">Cambiar frecuencia de muestreo</string>
    <string name="sensor_detail_record_extra">Registrar datos adicionales</string>
    <string name="sensor_detail_configure_sensor">Configurar este sensor</string>
    <string name="sensor_detail_units_title">Unidades</string>
    <string name="sensor_detail_units_accel_body">Se expresa en m/s², siempre en el sistema de coordenadas del dispositivo (x, y, z). Se considera g = 9,80665 m/s².</string>
    <string name="sensor_detail_units_gyro_body">Se expresa en rad/s, siguiendo la regla de la mano derecha alrededor de cada eje.</string>
    <string name="sensor_detail_view_units_reference">Ver referencia de unidades</string>
    <string name="sensor_detail_view_coordinates_reference">Ver referencia de coordenadas</string>
    <string name="sensor_detail_recent_readings">Lecturas más recientes</string>
    <string name="sensor_detail_recent_readings_body">A continuación se muestran las lecturas en tiempo real de este sensor.</string>
    <string name="sensor_detail_info_title">Información del sensor</string>
    <string name="sensor_detail_info_body">El fabricante del dispositivo proporcionó la siguiente información sobre este sensor. Toca para copiar.</string>
    <string name="sensor_detail_analysis_resources">Herramientas de análisis</string>
    <string name="sensor_detail_unavailable">Este sensor no está disponible en este dispositivo.</string>
    <string name="sensor_detail_waiting">Esperando lecturas del sensor…</string>
    <string name="sensor_detail_chart_filter_note">Los gráficos se suavizan solo para su visualización. Las lecturas numéricas y los archivos guardados conservan los valores originales.</string>
    <string name="sensor_detail_gps_active">Señal GPS disponible.</string>
    <string name="sensor_detail_gps_description">Registra la posición geográfica, la precisión y la velocidad proporcionadas por el sistema de ubicación del dispositivo.</string>
    <string name="sensor_detail_barometer_description">Mide la presión atmosférica y calcula una estimación de altitud respecto de la presión estándar al nivel del mar.</string>
    <string name="sensor_detail_camera_description">Graba video de la ruta con un perfil HD 720p de bajo consumo, limitado a aproximadamente 2 Mbps para reducir el calentamiento, el consumo de batería y el almacenamiento.</string>
    <string name="sensor_detail_microphone_description">Graba audio ambiental mono AAC a 24 kHz y 48 kbps y muestra la amplitud instantánea de la señal.</string>
    <string name="sensor_detail_units_gps_body">La latitud y la longitud se expresan en grados decimales, la precisión en metros y la velocidad en metros por segundo.</string>
    <string name="sensor_detail_units_barometer_body">Presión en hectopascales (hPa) y altitud estimada en metros (m).</string>
    <string name="sensor_detail_units_camera_body">El video se guarda como archivo multimedia asociado a la grabación.</string>
    <string name="sensor_detail_units_microphone_body">La amplitud es una escala digital instantánea de 0 a 32767; el audio se guarda como archivo multimedia.</string>
    <string name="sensor_detail_gps_note">Las actualizaciones GPS más frecuentes aumentan el consumo de batería.</string>
    <string name="sensor_detail_camera_note">La grabación requiere 250 MB de espacio libre y se detiene automáticamente si la batería alcanza 45 °C. Los demás sensores siguen grabando.</string>
    <string name="sensor_detail_microphone_note">Se necesita permiso de micrófono y es posible que se graben conversaciones del entorno.</string>
    <string name="sensor_detail_battery_level_description">Muestra el porcentaje actual de carga informado por Android.</string>
    <string name="sensor_detail_battery_temperature_description">Muestra la temperatura actual de la batería informada por Android.</string>
    <string name="sensor_detail_units_battery_level_body">Nivel de carga en porcentaje (%).</string>
    <string name="sensor_detail_units_battery_temperature_body">Temperatura de la batería en grados Celsius (°C).</string>
    <string name="sensor_detail_battery_note">Los valores los proporciona el sistema y la precisión depende del hardware del dispositivo.</string>
